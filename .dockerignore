.env.*
!.env.example

# vcs / tooling
.git
.gitignore
.vercel

# tests & docs (not needed in the image)
coverage
**/*.test.ts
**/*.test.tsx
vitest.config.mjs
vitest.setup.ts
test

# app-specific working dirs
.freebuff
graphify-out
supabase
scripts
